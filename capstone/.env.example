# DatasheetQA — Environment Variables
# Copy this file to .env or export these variables in your shell

# ── Primary LLM: NVIDIA NIM (build.nvidia.com) ──────────────────────────────
# Get your free key at: https://build.nvidia.com → "Get API Key"
NVIDIA_API_KEY=your-nvidia-nim-api-key-here

# ── Fallback LLM: Google Gemini ─────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
